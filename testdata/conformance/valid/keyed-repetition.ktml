Board [groups: [Group], tags: [string], state: BoardState] default {
	section {
		for group in groups key group.id {
			h2 { "{group.title}" }
			for card in group.cards key card.id {
				p { "{card.title}" }
			}
		}
	}
	ul {
		for tag in tags key tag {}
	}
	label for="tags"
}

Board [state = Loaded, items] {
	for item in items key item.id {
		li { "{item.title}" }
	}
}
