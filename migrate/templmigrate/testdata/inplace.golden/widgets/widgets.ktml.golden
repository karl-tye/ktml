// Converted from widgets/widgets.templ by ktml migrate templ (templ v0.3.1020).
import { ListView, ListItem, PanelView, StampView, GreetingView } from "./widgets.ktmlschema"

// Badge (widgets/widgets.templ:6).
Badge [text: string, count: integer] {
	span class="badge" "{text} {count}"
}

// List (widgets/widgets.templ:11).
List [view: ListView] {
	ul {
		for item in view.items key item.key {
			li id="{item.idItemID}" "{item.labelItem}"
		}
	}
}

// Panel (widgets/widgets.templ:20).
Panel [view: PanelView, children?: content] {
	section {
		h2 "{view.labelItem}"
		children
	}
}

// Stamp (widgets/widgets.templ:25).
Stamp [view: StampView] {
	time datetime="{view.datetimeNowUTCFormat}" "{view.text}"
}

// Greeting (widgets/widgets.templ:30).
Greeting [view: GreetingView] {
	p "{view.greeting}, {view.ctxValueUserKey}"
}

// Group (widgets/widgets.templ:35).
Group [parts?: content] {
	div class="group" {
		parts
	}
}

// Pair (widgets/widgets.templ:44).
Pair {
	Badge text="a" count=1
	Badge text="b" count=2
}

// Labelled (widgets/widgets.templ:50).
Labelled [text: string, icon?: content] {
	span {
		if icon? {
			i {
				icon
			}
			" "
		}
		"{text}"
	}
}

// Forward (widgets/widgets.templ:60).
Forward [text: string, icon?: content] {
	if icon? {
		Labelled text="{text}" {
			slot icon {
				icon
			}
		}
	} else {
		Labelled text="{text}"
	}
}

// Framed (widgets/widgets.templ:65).
Framed [icon?: content] {
	b {
		icon
	}
}

// PassFramed (widgets/widgets.templ:70).
PassFramed [icon?: content] {
	Framed {
		slot icon {
			icon
		}
	}
}

// Actions (widgets/widgets.templ:75).
Actions [title: string, actions?: content] {
	h3 "{title}"
	if actions? {
		div class="actions" {
			actions
		}
	}
}
