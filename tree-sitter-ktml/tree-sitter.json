{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ktml",
      "camelcase": "KTML",
      "title": "KTML",
      "scope": "source.ktml",
      "file-types": [
        "ktml",
        "ktmlschema"
      ],
      "injection-regex": "^ktml$",
      "class-name": "TreeSitterKtml"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "KTML grammar for tree-sitter",
    "authors": [
      {
        "name": "Karl Tye"
      }
    ],
    "links": {
      "repository": "https://github.com/karl-tye/ktml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}