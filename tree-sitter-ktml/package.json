{
  "name": "tree-sitter-ktml",
  "version": "0.1.0",
  "description": "KTML grammar for tree-sitter",
  "repository": "https://github.com/karl-tye/ktml",
  "license": "MIT",
  "author": {
    "name": "Karl Tye"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "ktml"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "node-gyp": "^12.4.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "test:grammar": "tree-sitter test",
    "verify": "npm run generate && node-gyp rebuild && npm run test:grammar && npm test"
  }
}
