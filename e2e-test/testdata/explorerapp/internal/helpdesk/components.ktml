// Helpdesk call audits: the list of answered calls, a call's analysis
// pipeline, and the evidence browser of a scored call.
import { AuditPageView, CallListView, CallListCall, CallRowView, DetailPageView, PipelineView, InteractiveReviewView, InteractiveReviewResult, InteractiveReviewTurn, AssessmentViewView, OutcomeCountView, CriterionResultViewView, TranscriptTurnViewView, AnalysisProgress, PipelineStages, StageStatus, RowAnalysis } from "./helpdesk.ktmlschema"
import { TD, TH } from "../ui/data.ktml"
import { PageNavigation } from "../ui/list.ktml"

// AuditPage lists the answered calls a team lead can send for analysis.
AuditPage [view: AuditPageView] {
	main class="flex-1 overflow-y-auto bg-base" {
		section class="border-b border-surface0 px-4 py-5 sm:px-6" aria-labelledby="call-audits-heading" {
			div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between" {
				div {
					p class="text-xs font-semibold uppercase tracking-wider text-blue" "Helpdesk"
					h1 id="call-audits-heading" class="mt-1 text-2xl font-bold text-text" "Call audits"
					p class="mt-1 max-w-2xl text-sm text-subtext1" "Send an answered customer call for analysis. The recording is transcribed and scored against the shop's call standards in the background."
				}
				div class="flex items-center gap-4" {
					if view.canManageStandards {
						a href="/call-audits/standards" class="text-sm font-medium text-blue hover:underline" "Call standards"
						" "
					}
					span class="text-sm text-subtext1" {
						span class="font-semibold text-text" "{view.callsOnPage}"
						" calls on this page"
					}
				}
			}
		}
		CallList view="{view.callList}"
	}
}

// CallList is a table of answered calls with paging.
CallList [view: CallListView] {
	section id="call-audit-list" aria-label="Answered calls" {
		div class="overflow-x-auto" {
			table class="min-w-full divide-y divide-surface0" {
				thead class="bg-surface0/40" {
					tr {
						TH header="Answered"
						TH header="Bookseller"
						TH header="Customer"
						TH header="Length"
						TH header="Call"
						TH header="Analysis"
					}
				}
				" "
				tbody class="divide-y divide-surface0" {
					if view.noCalls {
						tr {
							td colspan="6" class="px-6 py-14 text-center text-sm text-subtext1" "No answered calls to audit yet."
						}
					}
					for call in view.calls key call.key {
						CallRow view="{call.callRow}"
					}
				}
			}
		}
		PageNavigation view="{view.pageNavigation}"
	}
}

// CallRow is one answered call and its analysis.
CallRow [view: CallRowView] {
	tr id="call-audit-{view.callID}" class="transition-colors hover:bg-surface0/40" {
		TD {
			span class="font-medium text-text" "{view.answeredOn}"
			" "
			span class="text-xs text-subtext1" "{view.answeredAt}"
		}
		TD {
			span class="font-medium text-text" "{view.answeredBy}"
		}
		TD {
			span class="font-mono text-sm text-text" "{view.customerReference}"
		}
		TD {
			span class="text-text" "{view.duration}"
		}
		TD {
			span class="font-mono text-xs text-subtext1" "{view.callID}"
		}
		TD {
			RowAnalysisCell analysis="{view.analysis}"
		}

	}
}

// DetailPage is one call with its analysis pipeline.
DetailPage [view: DetailPageView] {
	main class="flex-1 overflow-y-auto bg-base" {
		header class="border-b border-surface0 px-4 py-5 sm:px-6" {
			a href="/call-audits" class="text-sm font-medium text-blue hover:underline" {
				i class="fas fa-arrow-left mr-2"
				"Call audits"
			}
			div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between" {
				div {
					p class="text-xs font-semibold uppercase tracking-wider text-blue" "Analysis"
					h1 class="mt-1 text-2xl font-bold text-text" "{view.answeredBy}"
					p class="mt-1 text-sm text-subtext1" "{view.answeredOn} · {view.duration} · {view.customerReference}"
				}
				span class="font-mono text-xs text-subtext1" "{view.callID}"
			}
		}
		Pipeline progress="{view.pipeline.progress}" stages="{view.pipeline.stages}"
	}
}

// Pipeline shows a call's analysis. One Render Clause per analysis
// progress: only a running analysis polls, only a complete one has
// results, and only a failed one has an error.
Pipeline [progress: AnalysisProgress, stages: PipelineStages]

Pipeline [progress = NotRequested] {
	section id="analysis-pipeline" class="p-4 sm:p-6" x-data=`{ stagesOpen: false }` aria-live="polite" {
		StageGrid stages="{stages}" collapsible=false
	}
}

Pipeline [progress = Running, callId] {
	section (
		id="analysis-pipeline"
		class="p-4 sm:p-6"
		x-data=`{ stagesOpen: false }`
		hx-get="/call-audits/{callId}/pipeline"
		hx-trigger="every 2s"
		hx-swap="outerHTML"
		aria-live="polite"
	) {
		StageGrid stages="{stages}" collapsible=false
	}
}

Pipeline [progress = Complete, assessment, interactive] {
	section id="analysis-pipeline" class="p-4 sm:p-6" x-data=`{ stagesOpen: false }` aria-live="polite" {
		div class="flex items-center justify-between border border-green/25 bg-green/5 px-4 py-3" {
			div class="flex items-center gap-2 text-sm font-medium text-green" {
				i class="fas fa-check-circle"
				"Analysis ready"
			}
			button (
				type="button"
				@click="stagesOpen = !stagesOpen"
				:aria-expanded="stagesOpen"
				class="text-xs font-semibold text-subtext1 transition-colors hover:text-text"
			) {
				span x-text="stagesOpen ? 'Hide stages' : 'Show stages'"
				i (
					class="fas fa-chevron-down ml-2 transition-transform duration-200 motion-reduce:transition-none"
					:class="stagesOpen && 'rotate-180'"
				)
			}
		}
		StageGrid stages="{stages}" collapsible=true
		AssessmentView view="{assessment}"
		" "
		InteractiveReview view="{interactive}"
	}
}

Pipeline [progress = Failed, message] {
	section id="analysis-pipeline" class="p-4 sm:p-6" x-data=`{ stagesOpen: false }` aria-live="polite" {
		StageGrid stages="{stages}" collapsible=false
		div class="mt-6 border border-red/30 bg-red/10 p-4 text-sm text-red" {
			strong "Analysis failed."
			" {message}"
		}
	}
}

// The four stage cards. A complete analysis folds them behind the
// banner's toggle.
StageGrid [stages: PipelineStages, collapsible: boolean] {
	div (
		if collapsible { x-show="stagesOpen" x-transition:enter="transition duration-200 ease-out motion-reduce:transition-none" x-transition:enter-start="opacity-0 -translate-y-1" x-transition:enter-end="opacity-100 translate-y-0" x-cloak }
		if collapsible { class="mt-3 grid gap-px overflow-hidden border border-surface0 bg-surface0 md:grid-cols-4" } else { class="grid gap-px overflow-hidden border border-surface0 bg-surface0 md:grid-cols-4" }
	) {
		StageCard status="{stages.recording}" number="1" title="Recording" description="Fetch the call's recording from the phone system"
		StageCard status="{stages.transcription}" number="2" title="Transcription" description="Speech to text, with each speaker's turns timed"
		StageCard status="{stages.scoring}" number="3" title="Scoring" description="Check the transcript against each call standard"
		StageCard status="{stages.complete}" number="4" title="Complete" description="The mark and coaching notes are ready"
	}
}

// InteractiveReview lists each standard's result; choosing one highlights
// its evidence in the transcript.
InteractiveReview [view: InteractiveReviewView] {
	div (
		x-data="\u007b\n\t\tselected: '', selectedStart: -1, selectedEnd: -1,\n\t\tselectCriterion(id, start, end) \u007b\n\t\t\tthis.selected = id; this.selectedStart = start; this.selectedEnd = end;\n\t\t\tthis.$nextTick(() => \u007b\n\t\t\t\tconst turn = [...this.$refs.transcript.querySelectorAll('[data-transcript-turn]')].find((element) => Number(element.dataset.end) >= start && Number(element.dataset.start) <= end);\n\t\t\t\tif (turn) turn.scrollIntoView(\u007b block: 'nearest' \u007d);\n\t\t\t\u007d);\n\t\t\u007d,\n\t\tturnSelected(start, end) \u007b return this.selected !== '' && end >= this.selectedStart && start <= this.selectedEnd; \u007d\n\t\u007d"
		class="mt-6 grid gap-6 xl:grid-cols-2"
	) {
		section class="border border-surface0 p-5" aria-labelledby="standards-heading" {
			h2 id="standards-heading" class="text-lg font-semibold text-text" "Standards"
			p class="mt-1 text-xs text-subtext0" "Choose a standard to find its evidence in the transcript."
			div class="mt-4 max-h-[36rem] divide-y divide-surface0 overflow-y-auto" {
				for result in view.results key result.key {
					if result.scored {
						CriterionResultView view="{result.criterionResultView}"
					}
				}
			}
		}
		section class="border border-surface0 p-5" aria-labelledby="transcript-heading" {
			div class="flex items-center justify-between gap-3" {
				h2 id="transcript-heading" class="text-lg font-semibold text-text" "Transcript"
				button (
					type="button"
					x-show="selected"
					@click="selected = ''; selectedStart = -1; selectedEnd = -1"
					class="text-xs font-medium text-blue hover:underline"
				) "Clear"
			}
			div (
				x-ref="transcript"
				class="mt-4 max-h-[36rem] space-y-1 overflow-y-auto font-mono text-xs leading-6 text-subtext1"
			) {
				for turn in view.turns key turn.key {
					TranscriptTurnView view="{turn.transcriptTurnView}"
				}
			}
		}
	}
}

// AssessmentView is the call's mark, its outcome counts, and the coaching
// notes, or the plain summary of a call scored before marks existed.
AssessmentView [view: AssessmentViewView] {
	section class="mt-6 border border-surface0 bg-surface0/20 p-5" aria-labelledby="mark-heading" {
		if view.hasResults {
			div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between" {
				div {
					p class="text-xs font-semibold uppercase tracking-widest text-blue" "Mark"
					h2 id="mark-heading" class="mt-1 text-4xl font-bold tabular-nums text-text" "{view.percentage}%"
					p class="mt-1 text-xs text-subtext0" "Unscored standards do not count towards the mark."
				}
				div class="flex gap-2" {
					OutcomeCount view="{view.passed}"
					OutcomeCount view="{view.failed}"
					OutcomeCount view="{view.unscored}"
				}
			}
			if view.mustPassFailed {
				div role="alert" class="mt-5 border-l-2 border-red bg-red/5 px-4 py-3 text-sm text-red" {
					strong "Must-pass standard failed."
					" A team lead should listen to this call."
				}
			}
			" "
			if view.hasCoaching {
				div class="mt-5 border-l-2 border-blue pl-4" {
					h3 class="text-xs font-semibold uppercase tracking-wider text-blue" "Coaching notes"
					p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-subtext1" "{view.coaching}"
				}
			}
		} else {
			h2 id="mark-heading" class="text-lg font-semibold text-text" "Summary"
			pre class="mt-4 whitespace-pre-wrap font-sans text-sm leading-6 text-subtext1" "{view.summary}"
		}
	}
}

// OutcomeCount is a count of one outcome.
OutcomeCount [view: OutcomeCountView] {
	div class="min-w-20 border border-surface1 bg-base px-3 py-2 text-center" {
		strong class="block text-lg tabular-nums {view.toneClass}" "{view.count}"
		span class="text-[10px] font-bold uppercase tracking-wider text-subtext0" "{view.outcome}"
	}
}

// CriterionResultView is a standard's outcome; with evidence, it selects
// the evidence's transcript range.
CriterionResultView [view: CriterionResultViewView] {
	button (
		type="button"
		class="block w-full py-4 text-left transition-colors first:pt-0 last:pb-0 hover:bg-surface0/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue/60"
		if view.evidence? {
			@click="selectCriterion({view.criterion}, {view.evidence.start}, {view.evidence.end})"
			:aria-pressed="selected === {view.criterion}"
			:class="selected === {view.criterion} && 'bg-blue/10'"
		} else { disabled }
	) {
		header class="flex flex-wrap items-center justify-between gap-2" {
			div class="flex items-center gap-2" {
				h3 class="font-mono text-xs font-semibold text-text" "{view.standardID}"
				if view.mustPass {
					span class="text-[9px] font-bold uppercase tracking-wider text-red" "Must pass"
				}
			}
			span class="border-l-2 px-2 py-1 text-[10px] font-bold tracking-wider {view.outcomeClass}" "{view.outcome}"
		}
		if view.hasTimestamp {
			p class="mt-2 font-mono text-xs text-blue" {
				i class="far fa-clock mr-1"
				"{view.timestamp}"
			}
		}
		p class="mt-2 text-sm leading-6 text-subtext1" "{view.note}"
	}
}

// TranscriptTurnView is one turn, highlighted while it is in the selected
// standard's evidence.
TranscriptTurnView [view: TranscriptTurnViewView] {
	article (
		data-transcript-turn
		data-start="{view.startSeconds}"
		data-end="{view.endSeconds}"
		class="rounded px-3 py-2 transition-colors duration-200 motion-reduce:transition-none"
		if view.even {
			:class="turnSelected({view.start}, {view.end}) ? 'bg-yellow/20 text-text' : 'bg-surface0/30'"
		} else {
			:class="turnSelected({view.start}, {view.end}) ? 'bg-yellow/20 text-text' : 'bg-base'"
		}
	) {
		div class="flex items-baseline gap-2" {
			time class="shrink-0 text-[10px] tabular-nums text-blue" "{view.time}"
			" "
			if view.hasSpeaker {
				strong class="text-[10px] uppercase tracking-wider text-subtext0" "{view.speaker}"
			}
		}
		p class="whitespace-pre-wrap text-xs leading-6" "{view.text}"
	}
}

// StageCard is one stage of the pipeline.
StageCard [status: StageStatus, number: string, title: string, description: string] {
	div class="bg-base p-5" {
		div class="flex items-center justify-between gap-3" {
			StageBadge status="{status}" number="{number}"
		}
		h2 class="mt-4 font-semibold text-text" "{title}"
		p class="mt-1 text-sm leading-5 text-subtext1" "{description}"
	}
}

// A stage's number and status icon. Every status has its own clause, so a
// new status cannot render without a design.
StageBadge [status: StageStatus, number: string]

StageBadge [status = Waiting] {
	span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface1 text-sm font-bold text-subtext1" "{number}"
	" "
}

StageBadge [status = Active] {
	span class="flex h-8 w-8 items-center justify-center rounded-full bg-blue text-sm font-bold text-crust" "{number}"
	" "
	i class="fas fa-spinner animate-spin text-blue" aria-hidden="true"
	" "
}

StageBadge [status = Done] {
	span class="flex h-8 w-8 items-center justify-center rounded-full bg-green text-sm font-bold text-crust" "{number}"
	" "
	i class="fas fa-check text-green" aria-hidden="true"
}

// The analysis cell of a call row: a requested analysis links to it, and
// any other call can be sent for analysis.
RowAnalysisCell [analysis: RowAnalysis]

RowAnalysisCell [analysis = Requested, requestedBy, link] {
	div class="flex flex-col gap-1" {
		span class="w-fit rounded-full bg-yellow/15 px-2.5 py-1 text-xs font-semibold text-yellow" "Requested"
		" "
		span class="text-xs text-subtext1" "by {requestedBy}"
		" "
		a href="{link}" class="mt-1 text-sm font-medium text-blue hover:underline" "Open analysis"
	}
}

RowAnalysisCell [analysis = NotRequested, callId] {
	form hx-post="/call-audits/{callId}/analysis" {
		input type="hidden" name="call_id" value="{callId}"
		" "
		button (
			type="submit"
			class="rounded-lg bg-blue px-3 py-2 text-sm font-semibold text-crust transition-colors hover:bg-blue/90"
		) {
			i class="fas fa-headset mr-2"
			"Analyse"
		}
	}
}
