EnquiryRow [status="converted"] {
	article id="enquiry-{id}" class="rounded-lg border border-green-200 bg-green-50 p-4" {
		div class="flex items-start justify-between gap-4" {
			div {
				h3 class="font-semibold text-slate-950" {
					"{customer}"
				}
				p class="text-sm text-slate-600" {
					"{summary}"
				}
			}
			span class="rounded-full bg-green-100 px-2 py-1 text-xs font-semibold text-green-800" {
				"Converted"
			}
		}
	}
}

EnquiryRow [
	id:       string,
	customer: string,
	summary:  string,
	status:   string,
] {
	article id="enquiry-{id}" class="rounded-lg border border-amber-200 bg-amber-50 p-4" {
		div class="flex items-start justify-between gap-4" {
			div {
				h3 class="font-semibold text-slate-950" {
					"{customer}"
				}
				p class="text-sm text-slate-600" {
					"{summary}"
				}
			}
			button id="convert-{id}" hx-put="/enquiries/{id}/status" hx-target="#enquiry-{id}" hx-swap="outerHTML" class="rounded-md bg-slate-900 px-3 py-2 text-xs font-semibold text-white" {
				"Convert"
			}
		}
	}
}

EnquiryCount [count: string] {
	span id="enquiry-count" hx-swap-oob="true" class="rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-800" {
		"{count} active enquiries"
	}
}

EnquiryInputs [empty: string] {
	div id="enquiry-inputs" hx-swap-oob="true" class="grid gap-3 md:grid-cols-2" {
		div {
			input id="enquiry-customer" name="customer" placeholder="Customer name" required="true" type="text"
		}
		div {
			input id="enquiry-summary" name="summary" placeholder="What does the customer need?" required="true" type="text"
		}
	}
}
